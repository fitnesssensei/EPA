# ============================================================
# EvPrApi — backend-агрегатор Events Provider API
# Файл .gitignore: что НЕ должно попадать в репозиторий.
# ============================================================

# ------------------------------------------------------------
# Виртуальные окружения Python.
# В репозиторий НИКОГДА не коммитим папку с пакетами:
# она весит сотни мегабайт и восстанавливается командой
# python3 -m venv .venv && pip install -e ".[dev]"
# ------------------------------------------------------------
.venv/
venv/
env/
ENV/
.venv*/
virtualenv/

# ------------------------------------------------------------
# Секреты и настройки окружения.
# .env содержит реальные URL, логины и API-ключи Events Provider,
# поэтому он в игноре. В репозиторий идёт только шаблон
# .env.example — в нём нет секретов, но есть список переменных.
# ------------------------------------------------------------
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# ------------------------------------------------------------
# Локальная папка TZz/ с вариантами и черновиками ТЗ.
# Это рабочие материалы, а не код проекта, поэтому в
# репозиторий они не попадают.
# ------------------------------------------------------------
TZz/

# ------------------------------------------------------------
# Кэш байт-кода и прочие артефакты интерпретатора Python.
# Пересоздаются автоматически при запуске.
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# ------------------------------------------------------------
# Артефакты сборки/установки пакета (pip install -e .).
# ------------------------------------------------------------
build/
dist/
downloads/
eggs/
.eggs/
*.egg
*.egg-info/
*.egg-link
pip-wheel-metadata/
MANIFEST

# ------------------------------------------------------------
# Кэши инструментов: тесты, линтер, типизация, покрытие.
# ------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.tox/
.nox/
.hypothesis/
coverage/
.coverage
.coverage.*
htmlcov/
*.cover
coverage.xml
nosetests.xml

# ------------------------------------------------------------
# Alembic: служебные файлы миграций.
# Папка alembic/versions/ коммитится (миграции — часть кода),
# а временные файлы БД — нет.
# ------------------------------------------------------------
*.sqlite3
*.db
*.sqlite

# ------------------------------------------------------------
# Данные локального PostgreSQL из docker-compose:
# том монтируется в ./data/postgres — коммитить его нельзя.
# ------------------------------------------------------------
data/
pgdata/
postgres-data/
*.dump

# ------------------------------------------------------------
# Логи приложения и воркера синхронизации.
# ------------------------------------------------------------
*.log
logs/
log/

# ------------------------------------------------------------
# Инструменты разработки (Poetry, PDM, pyenv).
# ------------------------------------------------------------
poetry.lock
pdm.lock
.pdm-python
.python-version

# ------------------------------------------------------------
# Редакторы и IDE: настройки у каждого свои.
# ------------------------------------------------------------
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.pydevproject
.spyderproject
.spyproject

# ------------------------------------------------------------
# macOS: системный мусор Finder.
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
ehthumbs.db
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Временные файлы, бэкапы и pid-файлы.
# ------------------------------------------------------------
*.bak
*.tmp
*.orig
*.rej
*.pid
.attach_pid*
