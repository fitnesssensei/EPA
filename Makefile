# ============================================================
# Makefile проекта EvPrApi — короткие команды для ежедневной работы.
#
# Раньше файл был пустым (0 байт), поэтому цели `make lint`,
# `make test`, `make dev` из плана проекта не существовали.
# Теперь все они работают.
#
# Быстрый старт:
#   make install   # создать venv и поставить зависимости
#   make lint      # проверить код линтером Ruff (PEP8)
#   make test      # запустить тесты
#   make dev       # поднять API локально
# ============================================================

# ------------------------------------------------------------
# Переменные. Используем интерпретатор и Ruff ИЗ ВИРТУАЛЬНОГО
# ОКРУЖЕНИЯ, чтобы локальный запуск совпадал с CI: там Ruff
# ставится из dev-группы pyproject.toml (ruff==0.16.8).
# Переопределить можно так: make lint RUFF="ruff"
# ------------------------------------------------------------
PY      ?= .venv/bin/python
PIP     ?= $(PY) -m pip
RUFF    ?= .venv/bin/ruff
PYTEST  ?= $(PY) -m pytest
UVICORN ?= .venv/bin/uvicorn
API_HOST ?= 127.0.0.1
API_PORT ?= 8000

# Цель по умолчанию — подсказка по доступным командам.
.DEFAULT_GOAL := help

# Объявляем цели «фальшивыми»: это не файлы, а команды.
# Иначе make может решить, что цель уже «выполнена» (например,
# если в каталоге случайно появится файл с именем test).
.PHONY: help venv install lint format test test-cov dev worker up down logs db clean

# ------------------------------------------------------------
# help — список команд (запускается по умолчанию, просто `make`).
# ------------------------------------------------------------
help:
	@echo "Доступные команды EvPrApi:"
	@echo "  make venv       — создать виртуальное окружение .venv"
	@echo "  make install    — создать venv и установить зависимости (.[dev])"
	@echo "  make lint       — линтер PEP8: ruff check + ruff format --check"
	@echo "  make format     — автоисправление: ruff check --fix + ruff format"
	@echo "  make test       — тесты pytest"
	@echo "  make test-cov   — тесты с отчётом о покрытии"
	@echo "  make dev        — запустить API (uvicorn --reload)"
	@echo "  make worker     — запустить воркер периодической синхронизации"
	@echo "  make up         — поднять всё в docker compose"
	@echo "  make down       — остановить docker compose"
	@echo "  make logs       — логи docker compose"
	@echo "  make clean      — удалить кеши (.ruff_cache, .pytest_cache, __pycache__)"

# ------------------------------------------------------------
# venv — создать виртуальное окружение.
# ------------------------------------------------------------
venv:
	python3 -m venv .venv
	$(PIP) install --upgrade pip setuptools wheel

# ------------------------------------------------------------
# install — окружение + зависимости проекта вместе с dev-группой.
# Именно здесь ставится Ruff пинованной версии из pyproject.toml.
# ------------------------------------------------------------
install:
	python3 -m venv .venv
	$(PIP) install --upgrade pip setuptools wheel
	$(PIP) install -e ".[dev]"

# ------------------------------------------------------------
# lint — ГЛАВНАЯ проверка ТЗ: соответствие кода PEP8.
# Те же две команды, что и в CI (.github/workflows/ci.yml),
# поэтому локально и в пайплайне результат одинаковый.
#   ruff check .          — нарушения правил (E/W/F/I/B/C4/UP/SIM);
#   ruff format --check . — код отформатирован единообразно.
# ------------------------------------------------------------
lint:
	$(RUFF) --version
	$(RUFF) check .
	$(RUFF) format --check .

# ------------------------------------------------------------
# format — автоматическое исправление стиля.
# Запускать перед коммитом, чтобы CI не ругался на мелочи.
# ------------------------------------------------------------
format:
	$(RUFF) check --fix .
	$(RUFF) format .

# ------------------------------------------------------------
# test / test-cov — тесты.
# ------------------------------------------------------------
test:
	$(PYTEST) -q

test-cov:
	$(PYTEST) -q --cov=app --cov-report=term-missing

# ------------------------------------------------------------
# dev — локальный запуск API: http://127.0.0.1:8000/docs
# ------------------------------------------------------------
dev:
	$(UVICORN) app.main:app --reload --host $(API_HOST) --port $(API_PORT)

# ------------------------------------------------------------
# worker — процесс фоновой синхронизации событий.
# ------------------------------------------------------------
worker:
	$(PY) -m app.workers.sync_worker

# ------------------------------------------------------------
# Docker: приложение + PostgreSQL.
# ------------------------------------------------------------
up:
	docker compose up --build -d

down:
	docker compose down

logs:
	docker compose logs -f

# ------------------------------------------------------------
# clean — удалить кеши инструментов (в git они не попадают).
# ------------------------------------------------------------
clean:
	rm -rf .ruff_cache .pytest_cache .coverage htmlcov
	find . -type d -name __pycache__ -not -path './.venv/*' -prune -exec rm -rf {} +

